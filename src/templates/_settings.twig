{# @var plugin \jtdev\craftautofill\AutofillPlugin #}
{# @var settings \jtdev\craftautofill\models\Settings #}

{% import '_includes/forms.twig' as forms %}

{% set providerOptions = [
    { label: 'OpenAI', value: 'openai' },
] %}

{% set reasoningOptions = [
    { label: 'Default', value: '' },
    { label: 'Low', value: 'low' },
    { label: 'Medium', value: 'medium' },
    { label: 'High', value: 'high' },
] %}

{% set envSuggestions = plugin.getEnvSuggestionsForAutosuggest() %}

{% set modelConfigRows = {} %}
{% for config in settings.modelConfigs %}
    {% set rowId = config.uid ?? ('row-' ~ loop.index) %}
    {% set modelConfigRows = modelConfigRows|merge({
        (rowId): {
            uid: config.uid ?? '',
            label: config.label ?? '',
            provider: config.provider ?? 'openai',
            apiKeyEnv: config.apiKeyEnv ?? '',
            modelId: config.modelId ?? '',
            reasoningEffort: config.reasoningEffort ?? '',
            enabled: config.enabled ?? true,
        }
    }) %}
{% endfor %}
{% if modelConfigRows is empty %}
    {% set modelConfigRows = {
        new1: {
            uid: '',
            label: '',
            provider: 'openai',
            apiKeyEnv: '',
            modelId: '',
            reasoningEffort: '',
            enabled: true,
        }
    } %}
{% endif %}

{{ forms.editableTableField({
    label: 'AI Model Configurations',
    instructions: 'Add one or more model configs. Store API keys as env var references like `$OPENAI_API_KEY`. The first enabled row is treated as the default. See OpenAI model docs for current model IDs.',
    id: 'modelConfigs',
    name: 'modelConfigs',
    cols: {
        uid: {
            type: 'singleline',
            heading: 'UID',
            class: 'hidden',
        },
        label: {
            type: 'singleline',
            heading: 'Internal Label',
            info: 'Used in admin/editor selections.',
            placeholder: 'Marketing Fast Draft',
        },
        provider: {
            type: 'select',
            heading: 'Provider',
            options: providerOptions,
            thin: true,
        },
        apiKeyEnv: {
            type: 'autosuggest',
            heading: 'API Key Env',
            suggestions: envSuggestions,
            suggestEnvVars: true,
            placeholder: '$OPENAI_API_KEY',
        },
        modelId: {
            type: 'singleline',
            heading: 'Model ID',
            placeholder: 'gpt-4.1-mini',
        },
        reasoningEffort: {
            type: 'select',
            heading: 'Reasoning',
            options: reasoningOptions,
            thin: true,
        },
        enabled: {
            type: 'lightswitch',
            heading: 'Enabled',
            thin: true,
        },
    },
    rows: modelConfigRows,
    allowAdd: true,
    allowDelete: true,
    allowReorder: true,
    defaultValues: {
        provider: 'openai',
        apiKeyEnv: '$OPENAI_API_KEY',
        enabled: true,
    },
    fullWidth: true,
    errors: settings.getErrors('modelConfigs')|unique,
}) }}

<datalist id="{{ 'autofill-env-suggestions'|namespaceInputId }}">
    {% for section in envSuggestions %}
        {% for suggestion in section.data ?? [] %}
            <option value="{{ suggestion.name }}">{{ suggestion.hint ?? '' }}</option>
        {% endfor %}
    {% endfor %}
</datalist>

{% js %}
(() => {
    const table = document.getElementById('{{ 'modelConfigs'|namespaceInputId|e('js') }}');
    const datalistId = '{{ 'autofill-env-suggestions'|namespaceInputId|e('js') }}';

    if (!table) {
        return;
    }

    const repairAddedApiKeyInputs = () => {
        table.querySelectorAll('textarea[name$="[apiKeyEnv]"]').forEach((textarea) => {
            const input = document.createElement('input');
            input.type = 'text';
            input.className = 'text fullwidth';
            input.name = textarea.name;
            input.value = textarea.value;
            input.placeholder = '$OPENAI_API_KEY';
            input.setAttribute('list', datalistId);
            textarea.replaceWith(input);
        });
    };

    repairAddedApiKeyInputs();

    const editableTable = window.jQuery ? window.jQuery(table).data('editable-table') : null;
    if (editableTable && typeof editableTable.on === 'function') {
        editableTable.on('addRow', repairAddedApiKeyInputs);
    }

    table.parentElement?.querySelector('.add')?.addEventListener('click', () => {
        window.setTimeout(repairAddedApiKeyInputs, 0);
    });
})();
{% endjs %}

<p class="light" style="margin-top: 10px;">
    Current model IDs are listed in the <a href="https://developers.openai.com/api/docs/models/compare" rel="noopener" target="_blank">OpenAI model comparison table</a>.
</p>

{{ forms.lightswitchField({
    label: 'Enable Test Mode',
    instructions: 'When enabled, editors can preview prompts and manually paste model responses for low-cost testing. When disabled, the Autofill button sends live AI requests directly.',
    id: 'testMode',
    name: 'testMode',
    on: settings.testMode ?? true,
}) }}

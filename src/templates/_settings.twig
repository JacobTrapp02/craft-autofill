{# @var plugin \jtdev\craftautofill\AutofillPlugin #}
{# @var settings \jtdev\craftautofill\models\Settings #}
{# @var openAiModelOptions array<int, array{label:string, value:string}>|null #}
{# @var openAiModelDiscoveryError string|null #}
{# @var openAiModelDiscoverySourceEnv string|null #}

{% import '_includes/forms.twig' as forms %}

{% set providerOptions = [
    { label: 'OpenAI', value: 'openai' },
] %}

{% set reasoningOptions = [
    { label: 'Default', value: '' },
    { label: 'Low', value: 'low' },
    { label: 'Medium', value: 'medium' },
    { label: 'High', value: 'high' },
] %}

{% set openAiModelOptions = openAiModelOptions ?? [] %}
{% set hasModelOptions = openAiModelOptions|length > 1 %}

{% set modelConfigRows = {} %}
{% for config in settings.modelConfigs %}
    {% set rowId = config.uid ?? ('row-' ~ loop.index) %}
    {% set rowModelId = config.modelId ?? '' %}
    {% set rowModelIdOptions = openAiModelOptions %}
    {% if hasModelOptions and rowModelId != '' %}
        {% set hasCurrentModel = false %}
        {% for option in rowModelIdOptions %}
            {% if option.value == rowModelId %}
                {% set hasCurrentModel = true %}
            {% endif %}
        {% endfor %}
        {% if not hasCurrentModel %}
            {% set rowModelIdOptions = rowModelIdOptions|merge([
                { label: rowModelId ~ ' (saved)', value: rowModelId }
            ]) %}
        {% endif %}
    {% endif %}

    {% set modelConfigRows = modelConfigRows|merge({
        (rowId): {
            uid: config.uid ?? '',
            label: config.label ?? '',
            provider: config.provider ?? 'openai',
            apiKeyEnv: config.apiKeyEnv ?? '',
            modelId: hasModelOptions ? {
                value: rowModelId,
                options: rowModelIdOptions,
            } : rowModelId,
            reasoningEffort: config.reasoningEffort ?? '',
            enabled: config.enabled ?? true,
        }
    }) %}
{% endfor %}

{{ forms.lightswitchField({
    label: 'Enable Test Mode',
    instructions: 'When enabled, editors can preview prompts and manually paste model responses for low-cost testing. When disabled, the Autofill button sends live AI requests directly.',
    id: 'testMode',
    name: 'testMode',
    on: settings.testMode ?? true,
}) }}

{{ forms.editableTableField({
    label: 'AI Model Configurations',
    instructions: 'Add one or more model configs. Store API keys as env var references like `$OPENAI_API_KEY`. The first enabled row is treated as the default.',
    id: 'modelConfigs',
    name: 'modelConfigs',
    cols: {
        uid: {
            type: 'singleline',
            heading: 'UID',
            class: 'hidden',
        },
        label: {
            type: 'singleline',
            heading: 'Internal Label',
            info: 'Used in admin/editor selections.',
            placeholder: 'Marketing Fast Draft',
        },
        provider: {
            type: 'select',
            heading: 'Provider',
            options: providerOptions,
            thin: true,
        },
        apiKeyEnv: {
            type: 'autosuggest',
            heading: 'API Key Env',
            suggestEnvVars: true,
            placeholder: '$OPENAI_API_KEY',
        },
        modelId: {
            type: hasModelOptions ? 'select' : 'singleline',
            heading: 'Model ID',
            placeholder: hasModelOptions ? null : 'gpt-4.1-mini',
            options: hasModelOptions ? openAiModelOptions : null,
        },
        reasoningEffort: {
            type: 'select',
            heading: 'Reasoning',
            options: reasoningOptions,
            thin: true,
        },
        enabled: {
            type: 'lightswitch',
            heading: 'Enabled',
            thin: true,
        },
    },
    rows: modelConfigRows,
    allowAdd: true,
    allowDelete: true,
    allowReorder: true,
    fullWidth: true,
    errors: settings.getErrors('modelConfigs')|unique,
}) }}

{% if openAiModelDiscoveryError %}
    <p class="warning has-icon" style="margin-top: 10px;">
        {{ openAiModelDiscoveryError }}
    </p>
{% elseif hasModelOptions %}
    <p class="light" style="margin-top: 10px;">
        Loaded {{ openAiModelOptions|length - 1 }} OpenAI models using {{ openAiModelDiscoverySourceEnv ?: 'configured API key env' }}.
    </p>
{% else %}
    <p class="light" style="margin-top: 10px;">
        OpenAI model list unavailable. You can still enter Model IDs manually.
    </p>
{% endif %}

{% set generationRowsDocsUrl = generationRowsDocsUrl ?? 'https://www.jtdevelop.com/development/plugins/autofill/autofill-fields#generation-rows' %}
{% set supportedFieldsDocsUrl = supportedFieldsDocsUrl ?? 'https://www.jtdevelop.com/development/plugins/autofill/supported-fields' %}
{% set advancedRowSettingsDocsUrl = advancedRowSettingsDocsUrl ?? 'https://www.jtdevelop.com/development/plugins/autofill/autofill-fields#advanced-row-settings' %}

<div class="matrixblock" data-row role="listitem">
    <div class="titlebar">
        <div class="blocktype"><strong>Autofill Row</strong></div>
        <div class="actions">
            <button type="button" class="btn small" data-action="move-up">Up</button>
            <button type="button" class="btn small" data-action="move-down">Down</button>
            <button type="button" class="btn small" data-action="remove-row">Remove</button>
        </div>
    </div>

    <div class="fields">
        <div class="target-prompt-row">
            <div class="field target-field-col">
                <div class="heading">
                    <label>
                        Target Field
                        {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                            tooltipHtml: 'Choose which entry field this row will update when suggestions are accepted. <a href="' ~ supportedFieldsDocsUrl ~ '" target="_blank" rel="noopener">See supported fields</a>.',
                            tooltipText: 'Choose which entry field this row will update when suggestions are accepted. See the supported fields docs.'
                        } only %}
                    </label>
                </div>
                <div class="input ltr">
                    <div class="select target-field-select-wrap">
                        <select class="js-target-field-select" name="rows[{{ rowId }}][targetFieldUid]">
                            {% for option in supportedFieldOptions %}
                                <option
                                    value="{{ option.value }}"
                                    {% if option.fieldType is defined %}data-field-type="{{ option.fieldType }}"{% endif %}
                                    {% if option.requiresPro ?? false %}data-requires-pro="1" class="autofill-pro-option"{% endif %}
                                    {% if option.value == (row.targetFieldUid ?? '') %} selected{% endif %}
                                >{{ option.label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="light autofill-target-meta" data-target-meta></div>
                </div>
            </div>

            <div class="field prompt-col">
                <div class="heading">
                    <label>
                        Prompt
                        {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                            tooltipHtml: 'This instruction is sent for this specific target field. Keep it direct and field-specific. <a href="' ~ generationRowsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                            tooltipText: 'This instruction is sent for this specific target field. Keep it direct and field-specific. Learn more in the generation rows docs.'
                        } only %}
                    </label>
                </div>
                <div class="input ltr">
                    <textarea class="text fullwidth" rows="2" name="rows[{{ rowId }}][prompt]" placeholder="Describe how this field should be generated">{{ row.prompt ?? '' }}</textarea>
                </div>
            </div>
        </div>

        <details class="autofill-advanced"{% if showAdvancedByDefault %} open{% endif %}>
            <summary class="autofill-advanced-summary"><span>Advanced Settings</span></summary>
            <div class="autofill-advanced-body">
                <div class="field lights-row">
                    <div class="heading">
                        <label>
                            Behavior
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'These switches control review flow, whether current values are sent to the model, and whether this row is active. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'These switches control review flow, whether current values are sent to the model, and whether this row is active. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                    </div>
                    <div class="input ltr autofill-row-toggles">
                        <label class="checkbox-label">
                            <input type="hidden" name="rows[{{ rowId }}][requiresApproval]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][requiresApproval]" value="1"{% if row.requiresApproval ?? true %} checked{% endif %}>
                            Requires Editor Approval
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'When enabled, this suggestion is shown in the review modal before it can be applied. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'When enabled, this suggestion is shown in the review modal before it can be applied. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                        <label class="checkbox-label">
                            <input type="hidden" name="rows[{{ rowId }}][includeCurrentFieldValue]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][includeCurrentFieldValue]" value="1"{% if row.includeCurrentFieldValue ?? true %} checked{% endif %}>
                            Include Current Field Value In Prompt
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'Sends the field current value as context so AI can refine or preserve what is already there. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'Sends the field current value as context so AI can refine or preserve what is already there. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                        <label class="checkbox-label">
                            <input type="hidden" name="rows[{{ rowId }}][overrideCurrentValue]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][overrideCurrentValue]" value="1"{% if row.overrideCurrentValue ?? true %} checked{% endif %}>
                            Override Current Value
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'If disabled and the field already has content, this row is skipped to avoid replacing existing values. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'If disabled and the field already has content, this row is skipped to avoid replacing existing values. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                        <label class="checkbox-label">
                            <input type="hidden" name="rows[{{ rowId }}][enabled]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][enabled]" value="1"{% if row.enabled ?? true %} checked{% endif %}>
                            Row Enabled
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'Quickly disable a row without deleting its prompt and target field setup. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'Quickly disable a row without deleting its prompt and target field setup. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                    </div>
                </div>

                <div class="field lights-row autofill-seomatic-config" data-seomatic-config hidden>
                    <div class="heading">
                        <label>
                            SEO Prompt Includes
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'Control which SEO properties are included in the AI contract for SEOmatic target fields. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'Control which SEO properties are included in the AI contract for SEOmatic target fields. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                    </div>
                    <div class="input ltr autofill-row-toggles">
                        <label class="checkbox-label" data-seomatic-option="seoTitle">
                            <input type="hidden" name="rows[{{ rowId }}][seomatic][includeSeoTitle]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][seomatic][includeSeoTitle]" value="1"{% if row.seomatic.includeSeoTitle ?? true %} checked{% endif %}>
                            Include SEO Title + Source
                        </label>
                        <label class="checkbox-label" data-seomatic-option="siteNamePosition">
                            <input type="hidden" name="rows[{{ rowId }}][seomatic][includeSiteNamePosition]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][seomatic][includeSiteNamePosition]" value="1"{% if row.seomatic.includeSiteNamePosition ?? true %} checked{% endif %}>
                            Include Site Name Position + Source
                        </label>
                        <label class="checkbox-label" data-seomatic-option="seoDescription">
                            <input type="hidden" name="rows[{{ rowId }}][seomatic][includeSeoDescription]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][seomatic][includeSeoDescription]" value="1"{% if row.seomatic.includeSeoDescription ?? true %} checked{% endif %}>
                            Include SEO Description + Source
                        </label>
                        <label class="checkbox-label" data-seomatic-option="seoKeywords">
                            <input type="hidden" name="rows[{{ rowId }}][seomatic][includeSeoKeywords]" value="0">
                            <input type="checkbox" name="rows[{{ rowId }}][seomatic][includeSeoKeywords]" value="1"{% if row.seomatic.includeSeoKeywords ?? true %} checked{% endif %}>
                            Include SEO Keywords + Source
                        </label>
                    </div>
                </div>

                <div class="field lights-row autofill-related-config" data-related-config hidden>
                    <div class="heading">
                        <label>
                            Related Selection Scope
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'Choose whether AI sees all candidates or only a Top N shortlist. Top N keeps prompts smaller and faster. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'Choose whether AI sees all candidates or only a Top N shortlist. Top N keeps prompts smaller and faster. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                    </div>
                    <div class="input ltr">
                        <div style="display:grid;grid-template-columns:minmax(160px,240px) minmax(140px,180px);gap:10px;align-items:end;">
                            <label class="field">
                                <div class="heading"><label>Mode</label></div>
                                <div class="input">
                                    <div class="select">
                                        <select name="rows[{{ rowId }}][related][mode]" data-related-mode>
                                            {% set relatedMode = row.related.mode ?? 'topN' %}
                                            <option value="topN"{% if relatedMode == 'topN' %} selected{% endif %}>Top N</option>
                                            <option value="all"{% if relatedMode == 'all' %} selected{% endif %}>All</option>
                                        </select>
                                    </div>
                                </div>
                            </label>
                            <label class="field" data-related-topn-wrap>
                                <div class="heading"><label>Top N</label></div>
                                <div class="input">
                                    <input
                                        class="text fullwidth"
                                        type="number"
                                        min="1"
                                        max="500"
                                        step="1"
                                        name="rows[{{ rowId }}][related][topN]"
                                        value="{{ row.related.topN ?? 25 }}"
                                        data-related-topn
                                    >
                                </div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="field lights-row autofill-link-config" data-link-config hidden>
                    <div class="heading">
                        <label>
                            Link Candidate Scope
                            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                                tooltipHtml: 'Control how many entry, category, and asset candidates are sent to AI for Link fields. Text-based link types do not use these candidate lists. <a href="' ~ advancedRowSettingsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                                tooltipText: 'Control how many entry, category, and asset candidates are sent to AI for Link fields. Text-based link types do not use these candidate lists. Learn more in the advanced row settings docs.'
                            } only %}
                        </label>
                    </div>
                    <div class="input ltr">
                        {% set linkModes = [
                            { value: 'topN', label: 'Top N' },
                            { value: 'mostRecent', label: 'Most Recent' },
                            { value: 'all', label: 'All' },
                            { value: 'none', label: 'None' },
                        ] %}
                        {% set linkTargets = [
                            { key: 'entry', label: 'Entries' },
                            { key: 'category', label: 'Categories' },
                            { key: 'asset', label: 'Assets' },
                        ] %}
                        <div style="display:grid;gap:12px;">
                            {% for target in linkTargets %}
                                {% set linkCfg = attribute(row.link ?? {}, target.key) ?? {} %}
                                {% set linkMode = linkCfg.mode ?? 'topN' %}
                                {% set linkCount = linkCfg.count ?? 10 %}
                                <div class="autofill-link-config__group" data-link-type-config="{{ target.key }}">
                                    <div class="heading"><label>{{ target.label }}</label></div>
                                    <div class="light" data-link-scope-summary="{{ target.key }}">Source scope will follow the selected Link field.</div>
                                    <div style="display:grid;grid-template-columns:minmax(160px,240px) minmax(140px,180px);gap:10px;align-items:end;">
                                        <label class="field">
                                            <div class="heading"><label>Mode</label></div>
                                            <div class="input">
                                                <div class="select">
                                                    <select name="rows[{{ rowId }}][link][{{ target.key }}][mode]" data-link-mode="{{ target.key }}">
                                                        {% for option in linkModes %}
                                                            <option value="{{ option.value }}"{% if linkMode == option.value %} selected{% endif %}>{{ option.label }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </div>
                                            </div>
                                        </label>
                                        <label class="field" data-link-count-wrap="{{ target.key }}">
                                            <div class="heading"><label>Count</label></div>
                                            <div class="input">
                                                <input
                                                    class="text fullwidth"
                                                    type="number"
                                                    min="0"
                                                    max="250"
                                                    step="1"
                                                    name="rows[{{ rowId }}][link][{{ target.key }}][count]"
                                                    value="{{ linkCount }}"
                                                    data-link-count="{{ target.key }}"
                                                >
                                            </div>
                                        </label>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </details>
    </div>
</div>

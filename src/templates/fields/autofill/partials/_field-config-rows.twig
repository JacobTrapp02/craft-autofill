<div class="field" data-autofill-row-settings-field>
    <div class="heading">
        <label>
            Field Configuration Rows
            {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
                tooltipHtml: 'Rows run in order. Each row targets one field and defines how AI should generate or review that field value. <a href="' ~ generationRowsDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
                tooltipText: 'Rows run in order. Each row targets one field and defines how AI should generate or review that field value. Learn more in the generation rows docs.'
            } only %}
        </label>
    </div>

    {{ hiddenInput('rows', '') }}

    <div class="matrix matrix-field autofill-row-builder" data-autofill-row-builder>
        <div class="blocks" data-rows-container role="list">
            {% for row in uiRows %}
                {% include 'autofill/fields/autofill/partials/_autofill-row.twig' with {
                    row: row,
                    rowId: 'row-' ~ loop.index0,
                    supportedFieldOptions: supportedFieldOptions,
                    showAdvancedByDefault: not (row.requiresApproval ?? true) or not (row.includeCurrentFieldValue ?? true) or not (row.overrideCurrentValue ?? true) or not (row.enabled ?? true),
                    generationRowsDocsUrl: generationRowsDocsUrl,
                    supportedFieldsDocsUrl: supportedFieldsDocsUrl,
                    advancedRowSettingsDocsUrl: advancedRowSettingsDocsUrl,
                } only %}
            {% endfor %}
        </div>

        <div class="buttons">
            <button type="button" class="btn add icon" data-action="add-row">Add Row</button>
        </div>
    </div>

    {% if rowErrors %}
        <ul class="errors">
            {% for error in rowErrors|unique %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</div>

<template data-row-template>
    {% include 'autofill/fields/autofill/partials/_autofill-row.twig' with {
        row: {
            targetFieldUid: '',
            prompt: '',
            requiresApproval: true,
            includeCurrentFieldValue: true,
            overrideCurrentValue: true,
            enabled: true,
            seomatic: {
                includeSeoTitle: true,
                includeSiteNamePosition: true,
                includeSeoDescription: true,
                includeSeoKeywords: true,
            },
            related: {
                mode: 'topN',
                topN: 25,
            },
        },
        rowId: '__INDEX__',
        supportedFieldOptions: supportedFieldOptions,
        showAdvancedByDefault: false,
        generationRowsDocsUrl: generationRowsDocsUrl,
        supportedFieldsDocsUrl: supportedFieldsDocsUrl,
        advancedRowSettingsDocsUrl: advancedRowSettingsDocsUrl,
    } only %}
</template>

<div class="autofill-review-modal-backdrop" data-autofill-review-backdrop hidden></div>

<div class="autofill-review-modal" data-autofill-review-modal hidden>
    <div class="heading">
        <label>Suggestion Review</label>
        <div class="instructions"><p data-autofill-review-status></p></div>
    </div>
    <div class="input ltr">
        <input type="text" class="text fullwidth" readonly data-autofill-review-field>
        <textarea class="text fullwidth" rows="3" data-autofill-review-value></textarea>
    </div>
    <div class="buttons">
        <button type="button" class="btn submit" data-autofill-accept>Accept</button>
        <button type="button" class="btn" data-autofill-reject>Reject</button>
        <button type="button" class="btn" data-autofill-prev>Prev</button>
        <button type="button" class="btn" data-autofill-next>Next</button>
        <button type="button" class="btn" data-autofill-close>Close</button>
    </div>
</div>

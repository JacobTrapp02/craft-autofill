<div class="autofill-review-link" data-autofill-review-input="link-preview">
    <div class="autofill-review-link__header">
        <span class="autofill-review-link__type" data-autofill-review-input="link-preview-type"></span>
        <span class="autofill-review-link__target" data-autofill-review-input="link-preview-target-badge" hidden>Opens in new tab</span>
    </div>
    <div class="autofill-review-link__destination" data-autofill-review-input="link-preview-destination"></div>
    <div class="autofill-review-link__url code" data-autofill-review-input="link-preview-url" hidden></div>
    <div class="autofill-review-link__meta" data-autofill-review-input="link-preview-context-row" hidden>
        <span data-autofill-review-input="link-preview-context"></span>
    </div>
    <div class="autofill-review-link__details">
        <div class="autofill-review-link__detail" data-autofill-review-input="link-preview-label-row" hidden>
            <span class="autofill-review-link__detail-label">Custom label</span>
            <span class="autofill-review-link__detail-value" data-autofill-review-input="link-preview-label"></span>
        </div>
        <div class="autofill-review-link__detail" data-autofill-review-input="link-preview-suffix-row" hidden>
            <span class="autofill-review-link__detail-label">URL suffix</span>
            <span class="autofill-review-link__detail-value code" data-autofill-review-input="link-preview-suffix"></span>
        </div>
    </div>
    <p class="autofill-review-link__hint">Preview only. Adjust the link directly in Craft if needed.</p>
</div>

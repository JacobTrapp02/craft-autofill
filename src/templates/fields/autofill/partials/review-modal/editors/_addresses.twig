<div class="autofill-review-editor-addresses" data-autofill-review-input="addresses">
    <div class="autofill-review-editor-addresses__list" data-autofill-review-input="addresses-list"></div>
    <div class="autofill-review-editor-addresses__actions">
        <button type="button" class="btn small" data-autofill-review-input="addresses-add">Add Address</button>
    </div>

    <template data-autofill-review-input="address-row-template">
        <div class="autofill-review-editor-address" data-autofill-review-input="address-row">
            <div class="autofill-review-editor-address__header">
                <strong data-autofill-review-input="address-heading">Address</strong>
                <button type="button" class="btn small" data-autofill-review-input="address-remove">Remove</button>
            </div>
            <input type="hidden" data-autofill-review-input="address-id" value="">
            <div class="autofill-review-editor-address__grid">
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Label</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-label" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Country</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-country" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Address Line 1</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-addressLine1" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Address Line 2</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-addressLine2" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Address Line 3</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-addressLine3" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">State</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-state" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">City</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-city" value="">
                </label>
                <label class="autofill-review-editor-address__field">
                    <span class="autofill-review-editor-address__label">Zip Code</span>
                    <input type="text" class="text fullwidth" data-autofill-review-input="address-zipCode" value="">
                </label>
            </div>
        </div>
    </template>
</div>

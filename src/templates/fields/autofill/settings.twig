{% import '_includes/forms.twig' as forms %}
{% do view.registerAssetBundle('craft\\web\\assets\\selectize\\SelectizeAsset') %}

{% set supportedFieldOptions = [{ label: 'Select a field', value: '' }] %}
{% set supportedFieldTypeMap = {} %}
{% for supportedField in supportedFields %}
    {% set fieldName = supportedField.name ?? '' %}
    {% set fieldHandle = supportedField.handle ?? '' %}
    {% set optionLabel = fieldName %}
    {% if fieldHandle != '' %}
        {% set optionLabel = fieldName ~ ' (' ~ fieldHandle ~ ')' %}
    {% endif %}

    {% set supportedFieldOptions = supportedFieldOptions|merge([
        {
            label: optionLabel,
            value: supportedField.uid,
            fieldType: supportedField.adapter,
        }
    ]) %}
    {% set supportedFieldTypeMap = supportedFieldTypeMap|merge({
        (supportedField.uid): supportedField.adapter
    }) %}
{% endfor %}

{% set uiRows = rows is not empty ? rows : [
    {
        targetFieldUid: '',
        prompt: '',
        requiresApproval: true,
        enabled: true,
    }
] %}

{% set uiContextRows = contextRows is not empty ? contextRows : [] %}

{{ forms.selectField({
    label: 'Entry Type Scope',
    tip: 'This scope controls which fields appear in row dropdowns and where this Autofill profile should be reused.',
    id: 'entryTypeUid',
    name: 'entryTypeUid',
    options: entryTypeOptions,
    value: field.entryTypeUid,
    errors: field.getErrors('entryTypeUid'),
}) }}

{{ forms.selectField({
    label: 'Model Config',
    tip: 'If empty, the first enabled model config in plugin settings is used. Set this when this field needs a specific model.',
    id: 'modelConfigUid',
    name: 'modelConfigUid',
    options: modelConfigOptions,
    value: field.modelConfigUid,
    errors: field.getErrors('modelConfigUid'),
}) }}

{{ forms.lightswitchField({
    label: 'Show Prompt Input Box',
    tip: 'Turn this off to simplify the editor experience when prompts should be fully controlled by field config only.',
    id: 'showUserPromptInput',
    name: 'showUserPromptInput',
    on: field.showUserPromptInput ?? true,
    errors: field.getErrors('showUserPromptInput'),
}) }}

{{ forms.textField({
    label: 'Action Button Label',
    tip: 'Leave blank to use the default label (`Generate` in Test Mode, `Autofill` in Live Mode).',
    id: 'actionButtonLabel',
    name: 'actionButtonLabel',
    value: field.actionButtonLabel,
    placeholder: 'Autofill',
    errors: field.getErrors('actionButtonLabel'),
}) }}

{% set rowErrors = field.getErrors('rows') %}
{% include 'autofill/fields/autofill/partials/_field-config-rows.twig' with {
    uiRows: uiRows,
    supportedFieldOptions: supportedFieldOptions,
    rowErrors: rowErrors,
} only %}

{% set contextRowErrors = field.getErrors('contextRows') %}
{% set globalPromptErrors = field.getErrors('globalPrompt') %}
{% include 'autofill/fields/autofill/partials/_global-context-fields.twig' with {
    uiContextRows: uiContextRows,
    supportedFieldOptions: supportedFieldOptions,
    globalPrompt: field.globalPrompt,
    globalPromptErrors: globalPromptErrors,
    contextRowErrors: contextRowErrors,
} only %}

{% css %}
{% include 'autofill/fields/autofill/assets/_settings.css.twig' %}
{% endcss %}

{% js %}
{% include 'autofill/fields/autofill/assets/_settings.js.twig' %}
{% endjs %}

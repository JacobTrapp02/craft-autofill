{% import '_includes/forms.twig' as forms %}
{% do view.registerAssetBundle('craft\\web\\assets\\selectize\\SelectizeAsset') %}

{% set docsBaseUrl = 'https://www.jtdevelop.com/development/plugins/autofill' %}
{% set autofillFieldsDocsUrl = docsBaseUrl ~ '/autofill-fields' %}
{% set entryTypeScopeDocsUrl = autofillFieldsDocsUrl ~ '#entry-type-scope' %}
{% set modelAndEditorDocsUrl = autofillFieldsDocsUrl ~ '#model-and-editor-controls' %}
{% set generationRowsDocsUrl = autofillFieldsDocsUrl ~ '#generation-rows' %}
{% set globalContextDocsUrl = autofillFieldsDocsUrl ~ '#global-context' %}
{% set advancedRowSettingsDocsUrl = autofillFieldsDocsUrl ~ '#advanced-row-settings' %}
{% set editorWorkflowDocsUrl = docsBaseUrl ~ '/editor-workflow' %}
{% set supportedFieldsDocsUrl = docsBaseUrl ~ '/supported-fields' %}
{% set supportedFieldsEndpoint = actionUrl('autofill/field-settings/supported-fields') %}

{% set entryTypeScopeHelpTip %}
    {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
        tooltipHtml: 'This scope controls which fields appear in row dropdowns and where this Autofill profile should be reused. <a href="' ~ entryTypeScopeDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
        tooltipText: 'This scope controls which fields appear in row dropdowns and where this Autofill profile should be reused. Learn more in the entry type scope docs.'
    } only %}
{% endset %}
{% set modelConfigHelpTip %}
    {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
        tooltipHtml: 'If empty, the first enabled model config in plugin settings is used. Set this when this field needs a specific model. <a href="' ~ modelAndEditorDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
        tooltipText: 'If empty, the first enabled model config in plugin settings is used. Set this when this field needs a specific model. Learn more in the model and editor controls docs.'
    } only %}
{% endset %}
{% set showPromptInputHelpTip %}
    {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
        tooltipHtml: 'Turn this off to simplify the editor experience when prompts should be fully controlled by field config only. <a href="' ~ editorWorkflowDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
        tooltipText: 'Turn this off to simplify the editor experience when prompts should be fully controlled by field config only. Learn more in the editor workflow docs.'
    } only %}
{% endset %}
{% set actionButtonLabelHelpTip %}
    {% include 'autofill/fields/autofill/partials/_help-tip.twig' with {
        tooltipHtml: 'Leave blank to use the default label: <code>Generate</code> in Test Mode, <code>Autofill</code> in Live Mode. <a href="' ~ modelAndEditorDocsUrl ~ '" target="_blank" rel="noopener">Learn more</a>.',
        tooltipText: 'Leave blank to use the default label: Generate in Test Mode, Autofill in Live Mode. Learn more in the model and editor controls docs.'
    } only %}
{% endset %}

{% set supportedFieldOptions = [{ label: 'Select a field', value: '' }] %}
{% set supportedFieldTypeMap = {} %}
{% set supportedFieldRequiresProMap = {} %}
{% for supportedField in supportedFields %}
    {% set fieldName = supportedField.name ?? '' %}
    {% set fieldHandle = supportedField.handle ?? '' %}
    {% set requiresPro = not isProEdition and not (supportedField.availableInFreeVersion ?? false) %}
    {% set optionLabel = fieldName %}
    {% if fieldHandle != '' %}
        {% set optionLabel = fieldName ~ ' (' ~ fieldHandle ~ ')' %}
    {% endif %}
    {% if requiresPro %}
        {% set optionLabel = optionLabel ~ ' - Pro' %}
    {% endif %}

    {% set supportedFieldOptions = supportedFieldOptions|merge([
        {
            label: optionLabel,
            value: supportedField.uid,
            fieldType: supportedField.adapter,
            requiresPro: requiresPro,
        }
    ]) %}
    {% set supportedFieldTypeMap = supportedFieldTypeMap|merge({
        (supportedField.uid): supportedField.adapter
    }) %}
    {% set supportedFieldRequiresProMap = supportedFieldRequiresProMap|merge({
        (supportedField.uid): requiresPro
    }) %}
{% endfor %}

{% set uiRows = rows is not empty ? rows : [
    {
        targetFieldUid: '',
        prompt: '',
        requiresApproval: true,
        enabled: true,
    }
] %}

{% set uiContextRows = contextRows is not empty ? contextRows : [] %}

{{ forms.selectField({
    label: 'Entry Type Scope ' ~ entryTypeScopeHelpTip,
    id: 'entryTypeUid',
    name: 'entryTypeUid',
    options: entryTypeOptions,
    value: field.entryTypeUid,
    errors: field.getErrors('entryTypeUid'),
}) }}

{{ forms.selectField({
    label: 'Model Config ' ~ modelConfigHelpTip,
    id: 'modelConfigUid',
    name: 'modelConfigUid',
    options: modelConfigOptions,
    value: field.modelConfigUid,
    errors: field.getErrors('modelConfigUid'),
}) }}

{{ forms.lightswitchField({
    label: 'Show Prompt Input Box ' ~ showPromptInputHelpTip,
    id: 'showUserPromptInput',
    name: 'showUserPromptInput',
    on: field.showUserPromptInput ?? true,
    errors: field.getErrors('showUserPromptInput'),
}) }}

{{ forms.textField({
    label: 'Action Button Label ' ~ actionButtonLabelHelpTip,
    id: 'actionButtonLabel',
    name: 'actionButtonLabel',
    value: field.actionButtonLabel,
    placeholder: 'Autofill',
    errors: field.getErrors('actionButtonLabel'),
}) }}

{% set rowErrors = field.getErrors('rows') %}
{% include 'autofill/fields/autofill/partials/_field-config-rows.twig' with {
    uiRows: uiRows,
    supportedFieldOptions: supportedFieldOptions,
    rowErrors: rowErrors,
    generationRowsDocsUrl: generationRowsDocsUrl,
    supportedFieldsDocsUrl: supportedFieldsDocsUrl,
    advancedRowSettingsDocsUrl: advancedRowSettingsDocsUrl,
} only %}

<div class="light autofill-field-settings-status" data-autofill-field-settings-status hidden></div>

<div class="autofill-section-spacer" aria-hidden="true"></div>

{% set contextRowErrors = field.getErrors('contextRows') %}
{% set globalPromptErrors = field.getErrors('globalPrompt') %}
{% include 'autofill/fields/autofill/partials/_global-context-fields.twig' with {
    uiContextRows: uiContextRows,
    supportedFieldOptions: supportedFieldOptions,
    globalPrompt: field.globalPrompt,
    globalPromptErrors: globalPromptErrors,
    contextRowErrors: contextRowErrors,
    globalContextDocsUrl: globalContextDocsUrl,
    supportedFieldsDocsUrl: supportedFieldsDocsUrl,
} only %}

{% css %}
{% include 'autofill/fields/autofill/assets/settings/index.css.twig' %}
{% endcss %}

{% js %}
window.autofillFieldSettings = {
    supportedFieldsEndpoint: '{{ supportedFieldsEndpoint|e('js') }}',
};
{% include 'autofill/fields/autofill/assets/settings/index.js.twig' %}
{% endjs %}

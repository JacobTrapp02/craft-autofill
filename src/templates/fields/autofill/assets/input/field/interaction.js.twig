(() => {
    // Brings target fields into view and prepares them for editor interaction.
    window.AutofillInputRuntime = window.AutofillInputRuntime || {};
    const runtime = window.AutofillInputRuntime;
    const HIGHLIGHT_CLASS = 'autofill-focus-highlight';
    const TOP_VIEWPORT_OFFSET = 96;
    let highlightedAnchor = null;
    let highlightedAnchorWasInert = false;

    const hasVisibleBox = (element) => {
        if (!(element instanceof HTMLElement)) {
            return false;
        }

        const rect = element.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) {
            return false;
        }

        const style = window.getComputedStyle(element);
        return style.display !== 'none' && style.visibility !== 'hidden';
    };

    const clickIfCollapsed = (control) => {
        if (!(control instanceof HTMLElement)) {
            return false;
        }

        const expanded = String(control.getAttribute('aria-expanded') || '').toLowerCase();
        const pressed = String(control.getAttribute('aria-pressed') || '').toLowerCase();
        if (expanded === 'true' || pressed === 'true') {
            return false;
        }

        control.click();
        return true;
    };

    const openDetailsSidebar = () => {
        const selectors = [
            '[aria-controls][aria-expanded="false"][aria-label*="sidebar" i]',
            '[aria-controls][aria-expanded="false"][aria-label*="details" i]',
            '[aria-controls][aria-expanded="false"][title*="sidebar" i]',
            '[aria-controls][aria-expanded="false"][title*="details" i]',
            '[data-icon="sidebar"][aria-expanded="false"]',
            '[data-icon="info"][aria-expanded="false"]',
            '.sidebar-toggle[aria-expanded="false"]',
            '.details-toggle[aria-expanded="false"]',
        ];

        for (const selector of selectors) {
            const control = document.querySelector(selector);
            if (clickIfCollapsed(control)) {
                return true;
            }
        }

        return false;
    };

    const revealHiddenAncestors = (input) => {
        let opened = false;
        let cursor = input.parentElement;
        while (cursor) {
            if (cursor.id) {
                const escapedId = window.CSS && typeof window.CSS.escape === 'function'
                    ? window.CSS.escape(cursor.id)
                    : cursor.id.replace(/"/g, '\\"');
                const control = document.querySelector(`[aria-controls="${escapedId}"][aria-expanded="false"]`);
                opened = clickIfCollapsed(control) || opened;
            }

            if (cursor.hasAttribute('hidden')) {
                cursor.removeAttribute('hidden');
                opened = true;
            }
            if (cursor.getAttribute('aria-hidden') === 'true') {
                cursor.setAttribute('aria-hidden', 'false');
                opened = true;
            }
            if (cursor.classList.contains('hidden')) {
                cursor.classList.remove('hidden');
                opened = true;
            }

            cursor = cursor.parentElement;
        }

        return opened;
    };

    const scrollFieldIntoTopView = (input) => {
        const anchor = runtime.getInteractionAnchor(input);
        const absoluteTop = anchor.getBoundingClientRect().top + window.scrollY;
        const targetY = Math.max(0, absoluteTop - TOP_VIEWPORT_OFFSET);
        window.scrollTo({ top: targetY, left: 0, behavior: 'auto' });
    };

    const activateTabForInput = (input) => {
        const nearestPane = input.closest('.pane[id], .content-pane[id], [id]');
        const panes = [];
        if (nearestPane instanceof HTMLElement) {
            panes.push(nearestPane);
        }

        const fallbackAncestors = [];
        let cursor = input.parentElement;
        while (cursor) {
            if (cursor.id) {
                fallbackAncestors.push(cursor);
            }
            cursor = cursor.parentElement;
        }

        const candidates = [...new Set([...panes, ...fallbackAncestors])];
        const pane = candidates.find((candidate) => {
            const id = candidate.id || '';
            return id.startsWith('tab') || id.includes('--') || candidate.classList.contains('pane') || candidate.classList.contains('content-pane');
        });

        if (!(pane instanceof HTMLElement)) {
            return;
        }

        const paneId = pane.id;
        if (!paneId) {
            return;
        }

        const selectors = [
            `.tabs a[href="#${paneId}"]`,
            `.tabs button[data-id="${paneId}"]`,
            `[role="tablist"] a[href="#${paneId}"]`,
            `[role="tablist"] [aria-controls="${paneId}"]`,
            `[data-tabs] a[href="#${paneId}"]`,
            `a[href="#${paneId}"]`,
        ];
        const tabTrigger = document.querySelector(selectors.join(', '));

        if (tabTrigger instanceof HTMLElement) {
            tabTrigger.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
            tabTrigger.click();
            if (window.location.hash !== `#${paneId}`) {
                history.replaceState(null, '', `#${paneId}`);
            }
            return;
        }

        pane.classList.remove('hidden');
        pane.classList.add('active');
        pane.style.display = '';
        pane.removeAttribute('aria-hidden');
        if (window.location.hash !== `#${paneId}`) {
            history.replaceState(null, '', `#${paneId}`);
        }
    };

    runtime.prepareInputForInteraction = (input, options = {}) => {
        revealHiddenAncestors(input);
        activateTabForInput(input);
        scrollFieldIntoTopView(input);
        const anchor = runtime.getInteractionAnchor(input);
        if (highlightedAnchor instanceof HTMLElement) {
            highlightedAnchor.classList.remove(HIGHLIGHT_CLASS);
            if (!highlightedAnchorWasInert) {
                highlightedAnchor.removeAttribute('inert');
            }
        }
        if (anchor instanceof HTMLElement) {
            highlightedAnchorWasInert = anchor.hasAttribute('inert');
            anchor.classList.add(HIGHLIGHT_CLASS);
            anchor.setAttribute('inert', '');
            highlightedAnchor = anchor;
        }
        if (
            anchor instanceof HTMLElement &&
            document.activeElement instanceof HTMLElement &&
            anchor.contains(document.activeElement)
        ) {
            document.activeElement.blur();
        }
        if (typeof options.positionReviewModal === 'function') {
            options.positionReviewModal(input);
        }
    };

    runtime.clearFieldHighlight = () => {
        if (highlightedAnchor instanceof HTMLElement) {
            highlightedAnchor.classList.remove(HIGHLIGHT_CLASS);
            if (!highlightedAnchorWasInert) {
                highlightedAnchor.removeAttribute('inert');
            }
        }
        highlightedAnchor = null;
        highlightedAnchorWasInert = false;
    };

    runtime.focusMatchedField = (matchedHandle, options = {}) => {
        if (!matchedHandle) {
            return;
        }

        const prepareMatchedInput = (input) => {
            if (!(input instanceof HTMLElement)) {
                return false;
            }

            runtime.prepareInputForInteraction(input, options);
            return true;
        };

        let input = runtime.findFieldInputByHandle(matchedHandle);
        if (!(input instanceof HTMLElement) || !hasVisibleBox(input)) {
            const sidebarOpened = openDetailsSidebar();
            input = runtime.findFieldInputByHandle(matchedHandle);
            if ((!(input instanceof HTMLElement) || !hasVisibleBox(input)) && sidebarOpened) {
                window.setTimeout(() => {
                    prepareMatchedInput(runtime.findFieldInputByHandle(matchedHandle));
                }, 120);
                return;
            }
        }

        prepareMatchedInput(input);
    };
})();

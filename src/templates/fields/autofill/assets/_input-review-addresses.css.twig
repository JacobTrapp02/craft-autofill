.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-addresses {
    display: grid;
    gap: 10px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-addresses__list {
    max-height: 46vh;
    overflow: auto;
    display: grid;
    gap: 10px;
    padding-right: 2px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-address {
    border: 1px solid #d9e2ec;
    border-radius: 8px;
    padding: 10px;
    background: #fff;
    display: grid;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-address__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-address__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-address__field {
    display: grid;
    gap: 4px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-address__label {
    font-size: 12px;
    font-weight: 600;
    color: #364656;
}

(() => {
    const builder = document.querySelector('[data-autofill-row-builder]');
    const container = builder?.querySelector('[data-rows-container]');
    const addButton = builder?.querySelector('[data-action="add-row"]');
    const template = document.querySelector('template[data-row-template]');

    const contextBuilder = document.querySelector('[data-autofill-context-builder]');
    const contextContainer = contextBuilder?.querySelector('[data-context-rows-container]');
    const addContextButton = contextBuilder?.querySelector('[data-action="add-context-row"]');
    const contextTemplate = document.querySelector('template[data-context-row-template]');
    const entryTypeSelect = document.querySelector('#{{ 'entryTypeUid'|namespaceInputId|e('js') }}');
    const settingsStatus = document.querySelector('[data-autofill-field-settings-status]');

    if (!builder || !container || !addButton || !template) {
        return;
    }

    let fieldTypeByUid = {{ supportedFieldTypeMap|json_encode|raw }};
    let fieldRequiresProByUid = {{ supportedFieldRequiresProMap|json_encode|raw }};
    let fieldLinkScopeByUid = {{ supportedFieldLinkScopeMap|json_encode|raw }};
    let currentFieldOptions = {{ supportedFieldOptions|json_encode|raw }};
    const isProEdition = {{ isProEdition ? 'true' : 'false' }};
    const hasSelectize = !!(window.jQuery && window.jQuery.fn && window.jQuery.fn.selectize);
    const supportedFieldsEndpoint = window.autofillFieldSettings?.supportedFieldsEndpoint || '';

    const fieldOptionLabel = (field) => {
        const name = String(field?.name || '');
        const handle = String(field?.handle || '');
        const requiresPro = !!field?.requiresPro;
        let label = handle ? `${name} (${handle})` : name;

        if (requiresPro) {
            label += ' - Pro';
        }

        return label;
    };

    const normalizeFieldOptions = (fields) => {
        const options = [{ label: 'Select a field', value: '' }];
        const nextFieldTypeByUid = {};
        const nextFieldRequiresProByUid = {};
        const nextFieldLinkScopeByUid = {};

        if (!Array.isArray(fields)) {
            return { options, fieldTypes: nextFieldTypeByUid, proFields: nextFieldRequiresProByUid, linkScopes: nextFieldLinkScopeByUid };
        }

        fields.forEach((field) => {
            const value = String(field?.uid || '');
            if (!value) {
                return;
            }

            const requiresPro = !isProEdition && (!!field?.requiresPro || field?.availableInLiteVersion === false);
            options.push({
                label: fieldOptionLabel({ ...field, requiresPro }),
                value,
                fieldType: String(field?.adapter || ''),
                requiresPro,
            });
            nextFieldTypeByUid[value] = String(field?.adapter || '');
            nextFieldRequiresProByUid[value] = requiresPro;
            nextFieldLinkScopeByUid[value] = field?.linkScopeSummary || null;
        });

        return { options, fieldTypes: nextFieldTypeByUid, proFields: nextFieldRequiresProByUid, linkScopes: nextFieldLinkScopeByUid };
    };

    const setSettingsStatus = (message, isError = false) => {
        if (!(settingsStatus instanceof HTMLElement)) {
            return;
        }

        settingsStatus.textContent = message || '';
        settingsStatus.hidden = !message;
        settingsStatus.classList.toggle('error', isError);
    };

    const formatFieldType = (raw) => {
        if (!raw) {
            return '';
        }
        const withSpaces = String(raw)
            .replace(/([a-z])([A-Z])/g, '$1 $2')
            .replace(/[_-]+/g, ' ');
        return withSpaces.charAt(0).toUpperCase() + withSpaces.slice(1);
    };

    const refreshFieldMeta = (row, selectSelector, metaSelector, labelPrefix = 'Field Type: ') => {
        const select = row?.querySelector(selectSelector);
        const meta = row?.querySelector(metaSelector);
        if (!select || !meta) {
            return;
        }

        const selectedOption = select.selectedOptions && select.selectedOptions.length > 0
            ? select.selectedOptions[0]
            : null;
        const optionFieldType = selectedOption?.dataset?.fieldType || '';
        const fieldType = formatFieldType(fieldTypeByUid[select.value] || optionFieldType);
        const requiresPro = !!fieldRequiresProByUid[select.value] || selectedOption?.dataset?.requiresPro === '1';

        if (!select.value) {
            meta.textContent = '';
            meta.classList.remove('autofill-upgrade-message');
            return;
        }

        if (requiresPro) {
            meta.textContent = 'Upgrade to Pro to get access to this field type.';
            meta.classList.add('autofill-upgrade-message');
            return;
        }

        meta.classList.remove('autofill-upgrade-message');
        meta.textContent = fieldType ? `${labelPrefix}${fieldType}` : '';
    };

    const refreshTargetMeta = (row) => {
        refreshFieldMeta(row, 'select.js-target-field-select', '[data-target-meta]', 'Field Type: ');
    };

    const refreshSeomaticConfig = (row) => {
        if (!row) {
            return;
        }

        const select = row.querySelector('select.js-target-field-select');
        const config = row.querySelector('[data-seomatic-config]');
        if (!(select instanceof HTMLSelectElement) || !(config instanceof HTMLElement)) {
            return;
        }

        const selectedOption = select.selectedOptions && select.selectedOptions.length > 0
            ? select.selectedOptions[0]
            : null;
        const selectedFieldType = fieldTypeByUid[select.value] || selectedOption?.dataset?.fieldType || '';
        const isSeomatic = String(selectedFieldType).trim().toLowerCase() === 'seomatic';
        config.hidden = !isSeomatic;
    };

    const isRelatedFieldType = (fieldType) => {
        const normalized = String(fieldType || '').trim().toLowerCase();
        return ['categories', 'tags', 'entries'].includes(normalized);
    };

    const isLinkFieldType = (fieldType) => String(fieldType || '').trim().toLowerCase() === 'link';

    const refreshRelatedConfig = (row) => {
        if (!row) {
            return;
        }

        const select = row.querySelector('select.js-target-field-select');
        const config = row.querySelector('[data-related-config]');
        if (!(select instanceof HTMLSelectElement) || !(config instanceof HTMLElement)) {
            return;
        }

        const selectedOption = select.selectedOptions && select.selectedOptions.length > 0
            ? select.selectedOptions[0]
            : null;
        const selectedFieldType = fieldTypeByUid[select.value] || selectedOption?.dataset?.fieldType || '';
        const enabled = isRelatedFieldType(selectedFieldType);
        config.hidden = !enabled;

        if (!enabled) {
            return;
        }

        const modeSelect = row.querySelector('[data-related-mode]');
        const topNWrap = row.querySelector('[data-related-topn-wrap]');
        const topNInput = row.querySelector('[data-related-topn]');
        if (!(modeSelect instanceof HTMLSelectElement) || !(topNWrap instanceof HTMLElement)) {
            return;
        }

        const mode = String(modeSelect.value || 'topN');
        const showTopN = mode !== 'all';
        topNWrap.hidden = !showTopN;

        if (topNInput instanceof HTMLInputElement) {
            topNInput.disabled = !showTopN;
        }
    };

    const refreshLinkConfig = (row) => {
        if (!row) {
            return;
        }

        const select = row.querySelector('select.js-target-field-select');
        const config = row.querySelector('[data-link-config]');
        if (!(select instanceof HTMLSelectElement) || !(config instanceof HTMLElement)) {
            return;
        }

        const selectedOption = select.selectedOptions && select.selectedOptions.length > 0
            ? select.selectedOptions[0]
            : null;
        const selectedFieldType = fieldTypeByUid[select.value] || selectedOption?.dataset?.fieldType || '';
        const linkScope = fieldLinkScopeByUid[select.value] || null;
        const enabled = isLinkFieldType(selectedFieldType);
        config.hidden = !enabled;

        if (!enabled) {
            return;
        }

        ['entry', 'category', 'asset'].forEach((typeKey) => {
            const modeSelect = row.querySelector(`[data-link-mode="${typeKey}"]`);
            const countWrap = row.querySelector(`[data-link-count-wrap="${typeKey}"]`);
            const countInput = row.querySelector(`[data-link-count="${typeKey}"]`);
            const summaryNode = row.querySelector(`[data-link-scope-summary="${typeKey}"]`);
            if (!(modeSelect instanceof HTMLSelectElement) || !(countWrap instanceof HTMLElement)) {
                return;
            }

            const mode = String(modeSelect.value || 'topN');
            const showCount = mode === 'topN' || mode === 'mostRecent';
            countWrap.hidden = !showCount;

            if (countInput instanceof HTMLInputElement) {
                countInput.disabled = !showCount;
            }

            if (summaryNode instanceof HTMLElement) {
                const typeScope = linkScope && typeof linkScope === 'object' ? linkScope[typeKey] : null;
                const summaryText = typeScope && typeof typeScope.summary === 'string'
                    ? typeScope.summary
                    : 'Source scope will follow the selected Link field.';
                summaryNode.textContent = `Included source scope: ${summaryText}`;
            }
        });
    };

    const refreshContextMeta = (row) => {
        refreshFieldMeta(row, 'select.js-global-context-select', '[data-context-meta]', 'Field Type: ');
    };

    const initSelectizeGroup = (row, selector, config = {}) => {
        if (!hasSelectize || !row) {
            return;
        }

        const $row = window.jQuery(row);
        $row.find(selector).each(function() {
            const $select = window.jQuery(this);
            if ($select.data('selectize')) {
                return;
            }

            $select.selectize({
                plugins: ['auto_position', 'selectize-plugin-a11y'],
                placeholder: 'Select a field',
                maxItems: 1,
                closeAfterSelect: true,
                allowEmptyOption: true,
                showEmptyOptionInDropdown: true,
                dropdownClass: 'autofill-field-select-dropdown',
                render: {
                    option(data, escape) {
                        const requiresPro = !!fieldRequiresProByUid[data.value];
                        const className = requiresPro ? 'option autofill-pro-option' : 'option';
                        return `<div class="${className}">${escape(data.text)}</div>`;
                    },
                    item(data, escape) {
                        const requiresPro = !!fieldRequiresProByUid[data.value];
                        const className = requiresPro ? 'item autofill-pro-option' : 'item';
                        return `<div class="${className}">${escape(data.text)}</div>`;
                    },
                },
                ...config,
            });
        });
    };

    const applyOptionsToSelect = (select) => {
        if (!(select instanceof HTMLSelectElement)) {
            return;
        }

        const currentValue = select.value;
        const hasCurrentValue = currentFieldOptions.some((option) => option.value === currentValue);
        const nextValue = hasCurrentValue ? currentValue : '';
        const selectize = select.selectize;

        select.innerHTML = '';
        currentFieldOptions.forEach((option) => {
            const optionElement = document.createElement('option');
            optionElement.value = option.value;
            optionElement.textContent = option.label;

            if (option.fieldType) {
                optionElement.dataset.fieldType = option.fieldType;
            }

            if (option.requiresPro) {
                optionElement.dataset.requiresPro = '1';
                optionElement.classList.add('autofill-pro-option');
            }

            optionElement.selected = option.value === nextValue;
            select.appendChild(optionElement);
        });

        select.value = nextValue;

        if (selectize) {
            selectize.clearOptions();
            currentFieldOptions.forEach((option) => {
                selectize.addOption({
                    text: option.label,
                    value: option.value,
                    fieldType: option.fieldType || '',
                    requiresPro: option.requiresPro ? '1' : '',
                });
            });
            selectize.setValue(nextValue, true);
            selectize.refreshOptions(false);
            selectize.refreshItems();
        }
    };

    const refreshAllSelectOptions = () => {
        container.querySelectorAll('select.js-target-field-select').forEach((select) => {
            applyOptionsToSelect(select);
        });
        contextContainer?.querySelectorAll('select.js-global-context-select').forEach((select) => {
            applyOptionsToSelect(select);
        });
        refreshAllFieldMeta();
        container.querySelectorAll('[data-row]').forEach((row) => {
            refreshSeomaticConfig(row);
            refreshRelatedConfig(row);
            refreshLinkConfig(row);
        });
    };

    const updateSupportedFields = (fields) => {
        const normalized = normalizeFieldOptions(fields);
        currentFieldOptions = normalized.options;
        fieldTypeByUid = normalized.fieldTypes;
        fieldRequiresProByUid = normalized.proFields;
        fieldLinkScopeByUid = normalized.linkScopes;
        refreshAllSelectOptions();
    };

    const requestSupportedFields = async (entryTypeUid) => {
        if (!supportedFieldsEndpoint) {
            return;
        }

        const body = new FormData();
        body.append('entryTypeUid', entryTypeUid);

        if (window.Craft?.csrfTokenName && window.Craft?.csrfTokenValue) {
            body.append(window.Craft.csrfTokenName, window.Craft.csrfTokenValue);
        }

        setSettingsStatus(entryTypeUid ? 'Loading fields for selected entry type...' : '');

        try {
            const response = await fetch(supportedFieldsEndpoint, {
                method: 'POST',
                headers: {
                    Accept: 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body,
                credentials: 'same-origin',
            });
            const data = await response.json();

            if (!response.ok || !data?.success) {
                throw new Error(data?.error || 'Could not load fields for the selected entry type.');
            }

            updateSupportedFields(data.fields || []);
            setSettingsStatus('');
        } catch (error) {
            setSettingsStatus(error instanceof Error ? error.message : 'Could not load fields for the selected entry type.', true);
        }
    };

    const initRowSelectize = (row) => {
        initSelectizeGroup(row, 'select.js-target-field-select', {
            placeholder: 'Select a target field',
            onInitialize() {
                refreshTargetMeta(row);
                refreshSeomaticConfig(row);
                refreshRelatedConfig(row);
                refreshLinkConfig(row);
            },
            onChange() {
                refreshTargetMeta(row);
                refreshSeomaticConfig(row);
                refreshRelatedConfig(row);
                refreshLinkConfig(row);
            },
        });
        refreshTargetMeta(row);
        refreshSeomaticConfig(row);
        refreshRelatedConfig(row);
        refreshLinkConfig(row);

        const modeSelect = row.querySelector('[data-related-mode]');
        if (modeSelect instanceof HTMLSelectElement && !modeSelect.dataset.boundRelatedMode) {
            modeSelect.addEventListener('change', () => {
                refreshRelatedConfig(row);
            });
            modeSelect.dataset.boundRelatedMode = '1';
        }

        ['entry', 'category', 'asset'].forEach((typeKey) => {
            const linkModeSelect = row.querySelector(`[data-link-mode="${typeKey}"]`);
            if (linkModeSelect instanceof HTMLSelectElement && !linkModeSelect.dataset.boundLinkMode) {
                linkModeSelect.addEventListener('change', () => {
                    refreshLinkConfig(row);
                });
                linkModeSelect.dataset.boundLinkMode = '1';
            }
        });
    };

    const initContextSelectize = (row) => {
        initSelectizeGroup(row, 'select.js-global-context-select', {
            placeholder: 'Select a context field',
            onInitialize() {
                refreshContextMeta(row);
            },
            onChange() {
                refreshContextMeta(row);
            },
        });
        refreshContextMeta(row);
    };

    const refreshAllFieldMeta = () => {
        container.querySelectorAll('[data-row]').forEach((row) => refreshTargetMeta(row));
        contextContainer?.querySelectorAll('[data-context-row]').forEach((row) => refreshContextMeta(row));
    };

    let index = container.querySelectorAll('[data-row]').length;
    let contextIndex = contextContainer ? contextContainer.querySelectorAll('[data-context-row]').length : 0;

    const addRow = () => {
        const token = `new-${index++}`;
        const html = template.innerHTML.split('__INDEX__').join(token);
        container.insertAdjacentHTML('beforeend', html);
        const row = container.lastElementChild;
        initRowSelectize(row);
        applyOptionsToSelect(row?.querySelector('select.js-target-field-select'));
        refreshAllFieldMeta();
    };

    const addContextRow = () => {
        if (!contextContainer || !contextTemplate) {
            return;
        }

        const token = `new-context-${contextIndex++}`;
        const html = contextTemplate.innerHTML.split('__CONTEXT_INDEX__').join(token);
        contextContainer.insertAdjacentHTML('beforeend', html);
        const row = contextContainer.lastElementChild;
        initContextSelectize(row);
        applyOptionsToSelect(row?.querySelector('select.js-global-context-select'));
        refreshAllFieldMeta();
    };

    container.querySelectorAll('[data-row]').forEach((row) => initRowSelectize(row));
    contextContainer?.querySelectorAll('[data-context-row]').forEach((row) => initContextSelectize(row));
    refreshAllFieldMeta();

    addButton.addEventListener('click', addRow);
    addContextButton?.addEventListener('click', addContextRow);
    if (entryTypeSelect instanceof HTMLSelectElement) {
        entryTypeSelect.addEventListener('change', () => {
            requestSupportedFields(entryTypeSelect.value);
        });
    }

    const handleRowActions = (event, options) => {
        const rawTarget = event.target;
        if (!(rawTarget instanceof HTMLElement)) {
            return;
        }

        const actionButton = rawTarget.closest('[data-action]');
        if (!(actionButton instanceof HTMLElement)) {
            return;
        }
        const action = actionButton.dataset.action || '';
        const row = actionButton.closest(options.rowSelector);
        if (!action || !row) {
            return;
        }

        if (action === options.removeAction) {
            row.remove();
            refreshAllFieldMeta();
            return;
        }

        if (!options.allowMove) {
            return;
        }

        if (action === 'move-up') {
            const prev = row.previousElementSibling;
            if (prev) {
                options.container.insertBefore(row, prev);
            }
            return;
        }

        if (action === 'move-down') {
            const next = row.nextElementSibling;
            if (next) {
                options.container.insertBefore(next, row);
            }
        }
    };

    container.addEventListener('click', (event) => handleRowActions(event, {
        container,
        rowSelector: '[data-row]',
        removeAction: 'remove-row',
        allowMove: true,
    }));

    contextContainer?.addEventListener('click', (event) => handleRowActions(event, {
        container: contextContainer,
        rowSelector: '[data-context-row]',
        removeAction: 'remove-context-row',
        allowMove: false,
    }));
})();

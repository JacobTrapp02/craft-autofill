{% set contextValueByUid = {} %}
{% set fieldNameByUid = {} %}
{% set fieldHandleByUid = {} %}

{% if element and element.getFieldLayout() %}
    {% for layoutField in element.getFieldLayout().getCustomFields() %}
        {% set fieldUid = layoutField.uid ?? '' %}
        {% if fieldUid %}
            {% set fieldNameByUid = fieldNameByUid|merge({ (fieldUid): layoutField.name ?? fieldUid }) %}
            {% set fieldHandleByUid = fieldHandleByUid|merge({ (fieldUid): layoutField.handle ?? '' }) %}

            {% set rawValue = element.getFieldValue(layoutField.handle ?? '') %}
            {% if rawValue is same as(null) %}
                {% set resolvedValue = '' %}
            {% elseif rawValue is iterable and rawValue is not same as('') %}
                {% set resolvedValue = rawValue|json_encode %}
            {% elseif rawValue is object %}
                {% set resolvedValue = rawValue|json_encode %}
            {% else %}
                {% set resolvedValue = rawValue ~ '' %}
            {% endif %}

            {% set contextValueByUid = contextValueByUid|merge({ (fieldUid): resolvedValue|trim }) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set previewConfig = {
    globalPrompt: field.globalPrompt ?? '',
    rows: field.rows ?? [],
    contextRows: field.contextRows ?? [],
    fieldNameByUid: fieldNameByUid,
    fieldHandleByUid: fieldHandleByUid,
    fieldContractsByUid: fieldContractsByUid ?? {},
    contextValueByUid: contextValueByUid,
} %}

<div class="autofill-runtime" data-autofill-runtime>
    <div class="field">
        <div class="heading">
            <label for="autofill-user-prompt-{{ field.handle }}">Prompt</label>
            <div class="instructions">
                <p>Enter user input/context, then click Generate to preview the exact prompt payload (no AI request is sent).</p>
            </div>
        </div>
        <div class="input ltr">
            <textarea
                id="autofill-user-prompt-{{ field.handle }}"
                class="text fullwidth"
                rows="5"
                data-autofill-user-prompt
                placeholder="Type your request/context here..."
            ></textarea>
        </div>
    </div>

    <div class="buttons">
        <button type="button" class="btn submit" data-autofill-generate>Generate</button>
    </div>

    <div class="field">
        <div class="heading">
            <label>Built Prompt Preview</label>
        </div>
        <div class="input ltr">
            <textarea class="text fullwidth code" rows="16" readonly data-autofill-preview placeholder="Preview appears here after clicking Generate."></textarea>
        </div>
    </div>

    <div class="field">
        <div class="heading">
            <label for="autofill-response-input-{{ field.handle }}">Test Response Input</label>
            <div class="instructions">
                <p>Paste AI JSON response here, then click Parse + Start Review.</p>
            </div>
        </div>
        <div class="input ltr">
            <textarea
                id="autofill-response-input-{{ field.handle }}"
                class="text fullwidth code"
                rows="8"
                data-autofill-response-input
                placeholder='[{"fieldName":"Phone Number","value":"555-123-4567"}]'
            ></textarea>
        </div>
    </div>

    <div class="buttons">
        <button type="button" class="btn" data-autofill-parse-response>Parse + Start Review</button>
    </div>

</div>

{% css %}
.autofill-review-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 9998;
}

.autofill-review-modal {
    position: fixed;
    top: 120px;
    left: 50%;
    transform: translateX(-50%);
    width: min(640px, calc(100vw - 32px));
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    z-index: 9999;
    padding: 14px;
}

.autofill-review-modal .heading {
    margin-bottom: 8px;
}

.autofill-review-modal .input textarea {
    min-height: 84px;
}

.autofill-review-modal .buttons {
    margin-top: 10px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
{% endcss %}

{% js %}
window.__autofillPreviewConfig = {{ previewConfig|json_encode|raw }};
{% include 'autofill/fields/autofill/assets/_input-runtime.js.twig' %}
{% endjs %}

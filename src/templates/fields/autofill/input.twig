{% set previewConfig = {
    fieldId: field.id ?? null,
    entryId: element.id ?? null,
    siteId: element.siteId ?? null,
    testMode: testMode ?? true,
    promptPreviewActionUrl: actionUrl('autofill/prompt-preview/build-prompt'),
    generateSuggestionsActionUrl: actionUrl('autofill/prompt-preview/generate-suggestions'),
    responseNormalizeActionUrl: actionUrl('autofill/response-preview/normalize-response'),
    applySuggestionActionUrl: actionUrl('autofill/response-preview/apply-suggestion'),
} %}
{% set isTestMode = testMode ?? true %}

<div class="autofill-runtime" data-autofill-runtime>
    <div class="field">
        <div class="heading">
            <label for="autofill-user-prompt-{{ field.handle }}">Prompt</label>
            <div class="instructions">
                {% if isTestMode %}
                    <p>Enter user input/context, then click Generate to preview the exact prompt payload (no AI request is sent).</p>
                {% else %}
                    <p>Enter user input/context, then click Autofill to generate and review suggestions.</p>
                {% endif %}
            </div>
        </div>
        <div class="input ltr">
            <textarea
                id="autofill-user-prompt-{{ field.handle }}"
                class="text fullwidth"
                rows="5"
                data-autofill-user-prompt
                placeholder="Type your request/context here..."
            ></textarea>
        </div>
    </div>

    <div class="buttons">
        <button type="button" class="btn submit" data-autofill-generate>{{ isTestMode ? 'Generate' : 'Autofill' }}</button>
    </div>

    {% if isTestMode %}
        <div class="field">
            <div class="heading">
                <label>Built Prompt Preview</label>
            </div>
            <div class="input ltr">
                <textarea class="text fullwidth code" rows="16" readonly data-autofill-preview placeholder="Preview appears here after clicking Generate."></textarea>
            </div>
        </div>

        <div class="field">
            <div class="heading">
                <label for="autofill-response-input-{{ field.handle }}">Test Response Input</label>
                <div class="instructions">
                    <p>Paste AI JSON response here, then click Parse + Start Review.</p>
                </div>
            </div>
            <div class="input ltr">
                <textarea
                    id="autofill-response-input-{{ field.handle }}"
                    class="text fullwidth code"
                    rows="8"
                    data-autofill-response-input
                    placeholder='[{"fieldName":"Phone Number","value":"555-123-4567"}]'
                ></textarea>
            </div>
        </div>

        <div class="buttons">
            <button type="button" class="btn" data-autofill-parse-response>Parse + Start Review</button>
        </div>
    {% endif %}

</div>

{% include 'autofill/fields/autofill/partials/_review-modal.twig' %}

{% css %}
.autofill-review-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    z-index: 9997;
}

.autofill-review-modal-backdrop[hidden],
.autofill-review-modal[hidden] {
    display: none;
}

.autofill-review-modal {
    position: fixed;
    top: 96px;
    left: 50%;
    transform: translateX(-50%);
    width: min(720px, calc(100vw - 32px));
    background: #fff;
    border-radius: 12px;
    border: 1px solid #d7dde5;
    box-shadow: 0 22px 44px rgba(15, 23, 42, 0.14), 0 6px 16px rgba(15, 23, 42, 0.08);
    z-index: 9999;
    padding: 18px 18px 16px;
}

.autofill-review-modal__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
}

.autofill-review-modal__title {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 600;
    color: #2f3a47;
}

.autofill-review-modal__counter {
    margin: 0;
    font-size: 12px;
    line-height: 1.3;
    font-weight: 500;
    color: #67778a;
}

.autofill-review-modal__body {
    display: grid;
    gap: 10px;
}

.autofill-review-modal__field {
    padding: 2px 0;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 600;
    color: #364656;
}

.autofill-review-modal__errors {
    margin: -2px 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: #b42318;
}

.autofill-review-modal [data-autofill-review-editor] textarea {
    min-height: 88px;
}

.autofill-review-modal [data-autofill-review-editor] .autofill-review-editor-datetime {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}

.autofill-review-modal__buttons {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.autofill-focus-highlight {
    position: relative;
    z-index: 9998;
    border-radius: 6px;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.95), 0 0 0 6px rgba(59, 130, 246, 0.20);
    animation: autofillPulse 1.1s ease-out;
}

@keyframes autofillPulse {
    0% {
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 1), 0 0 0 10px rgba(59, 130, 246, 0.30);
    }
    100% {
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.95), 0 0 0 6px rgba(59, 130, 246, 0.20);
    }
}
{% endcss %}

{% js %}
window.__autofillPreviewConfig = {{ previewConfig|json_encode|raw }};
{% include 'autofill/fields/autofill/assets/_input-api.js' %}
{% include 'autofill/fields/autofill/assets/_input-field-locator.js' %}
{% include 'autofill/fields/autofill/assets/_input-field-interaction.js' %}
{% include 'autofill/fields/autofill/assets/_input-review-renderers.js' %}
{% include 'autofill/fields/autofill/assets/_input-review-modal.js' %}
{% include 'autofill/fields/autofill/assets/_input-suggestion-flow.js' %}
{% include 'autofill/fields/autofill/assets/_input-runtime.js' %}
{% endjs %}
